{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Supabase: Link project (one-time)",
      "type": "shell",
      "command": "npx supabase link",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {}
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true
      },
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "label": "Supabase: Push migrations to remote",
      "type": "shell",
      "command": "npx supabase db push",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": true
      },
      "group": "build"
    },
    {
      "label": "Supabase: New empty migration",
      "type": "shell",
      "command": "npx supabase migration new ${input:migrationName}",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Supabase: Show migration status (remote)",
      "type": "shell",
      "command": "npx supabase migration list",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ],
  "inputs": [
    {
      "id": "migrationName",
      "type": "promptString",
      "description": "Migration name (e.g. add_achievements_table)",
      "default": "change_description"
    }
  ]
}
