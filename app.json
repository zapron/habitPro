{
  "expo": {
    "name": "habitPro",
    "owner": "raktim24",
    "slug": "habitPro",
    "scheme": "habitpro",
    "version": "1.1.29",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "portrait",
    "icon": "./assets/habitpro-logo-transparent-v3.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-wordmark.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8FAFC"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.rakti.habitpro",
      "versionCode": 30,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-v3-padded.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "com.android.vending.BILLING",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/swirling-gradient-flame-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-wordmark.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#F8FAFC"
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "defaultChannel": "default",
          "color": "#6366f1"
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow habitPro to attach photos to your streak memories.",
          "cameraPermission": "Allow habitPro to capture photos for streak memories."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cdfc2b93-f246-47b6-94ca-6a816ffda876"
      }
    }
  }
}
