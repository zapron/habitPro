{
  "expo": {
    "name": "habitPro",
    "slug": "habitPro",
    "scheme": "habitpro",
    "version": "1.0.0",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "portrait",
    "icon": "./assets/habit-pro-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/habit-pro-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#070b14"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.rakti.habitpro",
      "adaptiveIcon": {
        "foregroundImage": "./assets/habit-pro-icon.png",
        "backgroundColor": "#070b14"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/habit-pro-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-secure-store"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cdfc2b93-f246-47b6-94ca-6a816ffda876"
      }
    }
  }
}
