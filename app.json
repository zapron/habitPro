{
  "expo": {
    "name": "habitPro",
    "owner": "raktim24",
    "slug": "habitPro",
    "scheme": "habitpro",
    "version": "1.1.31",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "portrait",
    "icon": "./assets/app-icon-v4.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": "1.1.31",
    "updates": {
      "url": "https://u.expo.dev/cdfc2b93-f246-47b6-94ca-6a816ffda876",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "splash": {
      "image": "./assets/splash-wordmark.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8FAFC",
      "dark": {
        "image": "./assets/splash-wordmark-dark.png",
        "backgroundColor": "#070B14"
      }
    },
    "ios": {
      "bundleIdentifier": "com.rakti.habitpro",
      "buildNumber": "32",
      "supportsTablet": false
    },
    "android": {
      "package": "com.rakti.habitpro",
      "versionCode": 32,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-v4-foreground.png",
        "backgroundColor": "#070B14"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "com.android.vending.BILLING",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/swirling-gradient-flame-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-wordmark.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#F8FAFC",
          "dark": {
            "image": "./assets/splash-wordmark-dark.png",
            "backgroundColor": "#070B14"
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "defaultChannel": "default",
          "color": "#6366f1"
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow habitPro to attach photos to your streak memories.",
          "cameraPermission": "Allow habitPro to capture photos for streak memories."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cdfc2b93-f246-47b6-94ca-6a816ffda876"
      }
    }
  }
}
