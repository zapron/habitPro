{
  "expo": {
    "name": "habitPro",
    "owner": "raktim24",
    "slug": "habitPro",
    "scheme": "habitpro",
    "version": "1.1.6",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "portrait",
    "icon": "./assets/swirling-gradient-flame-logo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/habit-pro-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.rakti.habitpro",
      "versionCode": 7,
      "adaptiveIcon": {
        "foregroundImage": "./assets/swirling-gradient-flame-logo.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "permissions": ["com.android.vending.BILLING"]
    },
    "web": {
      "favicon": "./assets/swirling-gradient-flame-logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "defaultChannel": "default",
          "color": "#6366f1"
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow habitPro to attach photos to your streak memories.",
          "cameraPermission": "Allow habitPro to capture photos for streak memories."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cdfc2b93-f246-47b6-94ca-6a816ffda876"
      }
    }
  }
}
